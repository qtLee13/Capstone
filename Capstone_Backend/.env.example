# ตัวอย่างค่า config — คัดลอกเป็น .env แล้วเติมค่าจริง
# ⚠️ ห้าม commit ไฟล์ .env จริง และห้าม scp ข้ามเครื่อง (ค่าแต่ละเครื่องไม่เหมือนกัน)

# ---- ความลับ ----
API_SECRET_KEY=            # token ที่ Gateway/.92/Dashboard ใช้เรียก AI server
API_SECRET_KEY_OLD=        # ใส่เฉพาะช่วง "หมุน token" เท่านั้น (รับ 2 ตัวชั่วคราว) — หมุนเสร็จให้ลบทิ้ง
VT_API_KEY=
IPQS_API_KEY=
ABUSEIPDB_API_KEY=

# ---- ฐานข้อมูล ----
DATABASE_URL=

# ---- ตรวจการปลอมตัวผู้ส่ง (sender_spoofing) ----
# 🔴 โดเมนทั้งหมดขององค์กร คั่นด้วย comma (รวมบริษัทลูก/แบรนด์ย่อย/โดเมนสำรอง)
# ใช้จับ BEC ที่ปลอมเป็นคนในองค์กรเอง ซึ่งอันตรายที่สุด (ทีม .92 ชี้ 2026-08-17)
# ถ้าไม่ตั้ง จะกันได้เฉพาะโดเมนที่บังเอิญโผล่ใน recipient ของแต่ละ request เท่านั้น
PROTECTED_DOMAINS=

# ---- อื่น ๆ ----
FEEDBACK_LABEL_PATH=logs/feedback_labels.jsonl
DATASET_CAPTURE=0          # 1 = เก็บ body อีเมลจริงลง JSONL (มี PII) — เปิดเฉพาะตอนตั้งใจเก็บ dataset
