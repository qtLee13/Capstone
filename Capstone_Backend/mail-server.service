[Unit]
Description=Capstone Mail Server (SMTP receiver, port 25)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=capstone
WorkingDirectory=/home/capstone/Capstone/Capstone_Backend
ExecStart=/home/capstone/Capstone/Capstone_Backend/venv/bin/python -u smtp_mail_server.py
# ให้ process ที่ไม่ใช่ root ผูกพอร์ต 25 (ต่ำกว่า 1024) ได้
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
